                            }
                        ],
                        "nullable": true
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "created",
                            "updated",
                            "status_changed",
                            "deleted"
                        ]
                    },
                    "changes": {
                        "properties": {
                            "before": {
                                "type": "object"
                            },
                            "after": {
                                "type": "object"
                            }
                        },
                        "type": "object",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
