    "components": {
        "schemas": {
            "Token": {
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "expires_in": {
                        "description": "Seconds until expiry",
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "TokenPair": {
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/User"
                    },
                    "access": {
                        "$ref": "#/components/schemas/Token"
                    },
                    "refresh": {
                        "$ref": "#/components/schemas/Token"
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "Error": {
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "LeadActivity": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "lead_id": {
